go 1.26.4

use (
	// ./communication/telegram/bot — temporarily excluded from the workspace.
	// The module still has a `replace eticket-v3/services/common => /home/...`
	// directive (path doesn't exist on CI), and including it in the workspace
	// causes Go to apply that replace to every other module's build graph,
	// breaking the bus/bus/nats CI jobs. The bot is consumed by eticket-v3 via
	// its own go.mod replace and does not need to be in this workspace to
	// build there. Removing the eticket-v3 coupling is tracked in
	// eticket-v3/docs/superpowers/specs/2026-05-16-gopkg-telegram-bot-extraction-design.md.
